---
import { withBase } from '@/lib/routes.js';

const slideshowUrl = withBase('/slideshow/');
---

<script define:vars={{ slideshowUrl }}>
  (() => {
    const alreadyCompleted = sessionStorage.getItem('protocolSlideshowComplete') === 'true';
    const alreadySkipped = sessionStorage.getItem('protocolSlideshowSkip') === 'true';
    const params = new URLSearchParams(window.location.search);
    const optedOut = params.has('desktop') || params.has('skipSlideshow');

    if (alreadyCompleted || alreadySkipped || optedOut) return;

    const ua = navigator.userAgent || '';
    const mobileUa = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(ua);
    const coarsePointer = window.matchMedia?.('(pointer: coarse)').matches ?? false;
    const narrowViewport = window.matchMedia?.('(max-width: 820px)').matches ?? false;
    const likelyMobile = mobileUa || (coarsePointer && narrowViewport);

    if (likelyMobile) {
      window.location.replace(slideshowUrl);
    }
  })();
</script>
