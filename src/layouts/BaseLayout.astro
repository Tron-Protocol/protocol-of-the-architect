---
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
const { title = 'The Protocol of the Architect', description = 'A public archive for The Protocol of the Architect.', eyebrow = 'Release the Protocol' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <slot name="head" />
  </head>
  <body>
    <div class="site-frame">
      <SiteHeader />
      <main>
        <slot name="hero" />
        <slot />
      </main>
      <footer class="footer"><div class="footer__inner">Anonymous open-access release. Human-readable and machine-readable archive structure.</div></footer>
    </div>
  </body>
</html>
