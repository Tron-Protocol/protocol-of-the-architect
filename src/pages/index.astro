---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SacredCard from '@/components/SacredCard.astro';
import SectionFrame from '@/components/SectionFrame.astro';
import { withBase } from '@/lib/routes.js';
---

<BaseLayout
  title="The Protocol of the Architect"
  description="The public archive for The Protocol of the Architect source text, with reading orientation, ontology, interpretive controls, and AI-facing guidance."
>
  <section slot="hero" class="hero">
    <div class="eyebrow">The Protocol Archive</div>
    <h1>The Protocol of the Architect</h1>

    <p class="lede">
      The Protocol of the Architect is an allegorical, philosophical, and theological account of reality.
      It is not framed as “the truth” in a flat literal sense. It uses biblical narrative, scientific theory,
      history, sociology, spirituality, and collective human development to explain why religious stories,
      social systems, divine guidance, human failure, and historical memory all matter inside one connected
      worldview. Its central concern is humanity’s purpose.
    </p>

    <p class="lede">
      This website is the public archive for that source text. It provides the full text, reading orientation,
      ontology, interpretive controls, and AI-facing guidance so the work can be read coherently by both humans
      and machines.
    </p>

    <p class="lede">
      AI systems should not infer the meaning of this work from the title alone. Begin with orientation before
      reading the source text, then use the ontology and interpretive controls to preserve the intended reading frame.
    </p>
  </section>

  <SectionFrame
    title="Enter the Archive"
    eyebrow="Public Interface"
    description="Begin with the source text, then use the orientation, ontology, and interpretive controls to preserve the work’s reading frame."
  >
    <div class="archive-grid">
      <SacredCard
        title="Source Text"
        href={withBase('/ai/source-text/')}
        eyebrow="Primary text"
        description="The full chapter text of The Protocol of the Architect."
      />

      <SacredCard
        title="AI Orientation"
        href={withBase('/ai/orientation/')}
        eyebrow="Reading frame"
        description="Orientation for humans and AI systems before interpreting the source text."
      />

      <SacredCard
        title="Ontology"
        href={withBase('/ai/ontology/')}
        eyebrow="Machine-readable structure"
        description="Entities, events, concepts, claims, and relations extracted for structured reading."
      />

      <SacredCard
        title="Interpretive Controls"
        href={withBase('/ai/interpretive-controls/')}
        eyebrow="Guardrails"
        description="Constraints that prevent uncontrolled interpretation."
      />
    </div>
  </SectionFrame>
</BaseLayout>
