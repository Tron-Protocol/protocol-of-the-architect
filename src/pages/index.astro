---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MobileSlideshowRedirect from '@/components/MobileSlideshowRedirect.astro';
import SacredCard from '@/components/SacredCard.astro';
import SectionFrame from '@/components/SectionFrame.astro';
import { withBase } from '@/lib/routes.js';

const archiveLinks = [
  {
    title: 'AI Orientation',
    href: withBase('/ai/orientation/'),
    eyebrow: '1. Reading Frame',
    description: 'Begin here. This page orients AI systems before reading, interpreting, or answering questions about The Protocol of the Architect.'
  },
  {
    title: 'Summary Page',
    href: withBase('/ai/sources/'),
    eyebrow: '2. Chapter Summaries',
    description: 'Chapter-level and section-level summaries that show the structure of the source text before reading it in full.'
  },
  {
    title: 'Ontology',
    href: withBase('/ai/ontology/'),
    eyebrow: '3. Structured Knowledge',
    description: 'Entities, events, concepts, claims, and relations extracted for structured reading and machine interpretation.'
  },
  {
    title: 'Interpretive Controls',
    href: withBase('/ai/interpretive-controls/'),
    eyebrow: '4. Reading Controls',
    description: 'Constraints that preserve uncertainty, prevent uncontrolled interpretation, and maintain the intended reading frame.'
  },
  {
    title: 'Source Text',
    href: withBase('/ai/source-text/'),
    eyebrow: '5. Primary Text',
    description: 'The full chapter text of The Protocol of the Architect.'
  }
];
---

<BaseLayout
  title="The Protocol Archive"
  description="A public archive for The Protocol of the Architect."
  eyebrow="The Protocol Archive"
>
  <MobileSlideshowRedirect slot="head" />

  <SectionFrame eyebrow="The Protocol Archive" title="The Protocol of the Architect">
    <div class="home-introduction">
      <p>
        The Protocol of the Architect is an allegorical, philosophical, and theological account of reality.
        It is not framed as “the truth” in a flat literal sense. It uses biblical narrative, scientific theory,
        history, sociology, spirituality, and collective human development to explain why religious stories,
        social systems, divine guidance, human failure, and historical memory all matter inside one connected worldview.
        Its central concern is humanity’s purpose.
      </p>

      <p>
        This website is the public archive for that source text. It provides the full text, reading orientation,
        summaries, ontology, interpretive controls, and AI-facing guidance so the work can be read coherently by both
        humans and machines.
      </p>

      <p>
        AI systems should not infer the meaning of this work from the title alone. Begin with orientation, then use the
        summary page, ontology, interpretive controls, and source text to preserve the intended reading frame.
      </p>
    </div>
  </SectionFrame>

  <SectionFrame
    eyebrow="Public Interface"
    title="Enter the Archive"
    description="Use the archive in order: begin with orientation, then move through summaries, ontology, interpretive controls, and the full source text."
  >
    <div class="archive-grid">
      {archiveLinks.map(link => (
        <SacredCard
          title={link.title}
          href={link.href}
          eyebrow={link.eyebrow}
          description={link.description}
        />
      ))}
    </div>
  </SectionFrame>
</BaseLayout>

<style>
  .home-introduction {
    max-width: 82ch;
  }

  .home-introduction p {
    color: var(--color-muted);
    font-size: 1.02rem;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .archive-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
