---
import AiPageLayout from '@/layouts/AiPageLayout.astro';
import SectionFrame from '@/components/SectionFrame.astro';
import WarningPanel from '@/components/WarningPanel.astro';
import { contentSources } from '@/lib/content.js';
const consult = contentSources.consult_the_protocol;
---
<AiPageLayout title="Consult the Protocol Rules" description={consult.public_role}>
  <WarningPanel title="User-triggered answering only" description="This page gives answer-policy rules to AI assistants. It is not a chatbot backend or retrieval system." />
  <SectionFrame title="Source Authority" eyebrow="Answer Policy">
    <pre>{JSON.stringify(consult.source_authority_model?.public_website_authority_hierarchy || consult.public_answer_policy || {}, null, 2)}</pre>
  </SectionFrame>
  <SectionFrame title="Failure Boundaries" eyebrow="Do not over-answer">
    <pre>{JSON.stringify(consult.failure_boundaries || {}, null, 2)}</pre>
  </SectionFrame>
  <SectionFrame title="Response Characteristics" eyebrow="Style">
    <pre>{JSON.stringify(consult.response_characteristics || {}, null, 2)}</pre>
  </SectionFrame>
</AiPageLayout>
