---
import AiPageLayout from '@/layouts/AiPageLayout.astro';
import WarningPanel from '@/components/WarningPanel.astro';
import OntologyRecordGroup from '@/components/OntologyRecordGroup.astro';
import { getControlModule } from '@/lib/content.js';
const module = getControlModule('canon_gates');
const records = module.records || module.gates || [];
---
<AiPageLayout title="Canon Gates" description={module.public_role}>
  <WarningPanel title="Control Layer" description="These records constrain interpretation. They are not decorative metadata." />
  <OntologyRecordGroup title="Canon Gates" description="Public controls are rendered without internal trace or provenance." records={records} />
</AiPageLayout>
