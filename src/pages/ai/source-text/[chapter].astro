---
import SourceTextLayout from '@/layouts/SourceTextLayout.astro';
import SourceTextBlock from '@/components/SourceTextBlock.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';
import { getSourceTextRecords, chapterSlug } from '@/lib/content.js';

export function getStaticPaths() {
  return getSourceTextRecords().map(record => ({
    params: { chapter: chapterSlug(record) },
    props: { record }
  }));
}

const { record } = Astro.props;

function sourceTextTitle(record) {
  if (record.chapter_id === 'CH00') return 'Introduction';

  const match = String(record.chapter_id).match(/^CH(\d+)$/);
  if (!match) return record.public_title;

  return `Chapter ${Number(match[1])}: ${record.public_title}`;
}
---

<SourceTextLayout title={sourceTextTitle(record)} description="Canon source text rendered as a reading panel. Interpretive trace remains hidden.">
  <RelatedLinks links={[
    { label: 'Source Summaries', href: '/ai/sources/' },
    { label: 'Orientation', href: '/ai/orientation/' },
    { label: 'Controls', href: '/ai/interpretive-controls/' }
  ]} />

  <SourceTextBlock text={record.full_text} />
</SourceTextLayout>
