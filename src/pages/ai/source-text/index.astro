---
import SourceTextLayout from '@/layouts/SourceTextLayout.astro';
import SacredCard from '@/components/SacredCard.astro';
import { getSourceTextRecords, chapterSlug } from '@/lib/content.js';
import { withBase } from '@/lib/routes.js';

function sourceTextTitle(record) {
  const publicTitles = {
    CH00: 'Introduction',
    CH01: 'Chapter 1: Origins',
    CH02: 'Chapter 2: Humanity',
    CH03: 'Chapter 3: Civilization',
    CH04: 'Chapter 4: Cultivation',
    CH05: 'Chapter 5: The Book of Jasher',
    CH06: 'Chapter 6: The House of Israel',
    CH07: 'Chapter 7: A New Path',
    CH08: 'Chapter 8: The Compendium of Caleb',
    CH09: 'Chapter 9: Exposition',
    CH10: 'Chapter 10: The Book of the Wars of the Lord'
  };

  return publicTitles[record.chapter_id] || record.public_title;
}
---

<SourceTextLayout title="Full Source Text" description="Assembled chapter text for The Protocol of the Architect.">
  <a class="mobile-return-link" href={withBase('/enter/')}>← Return</a>

  <div class="archive-grid">
    {getSourceTextRecords().map(chapter => (
      <SacredCard
        title={sourceTextTitle(chapter)}
        href={withBase(`/ai/source-text/${chapterSlug(chapter)}/`)}
        eyebrow={`${chapter.text_character_count} characters`}
        description="Read the full assembled source text."
      />
    ))}
  </div>
</SourceTextLayout>

<style>
  .mobile-return-link {
    display: inline-block;
    margin: 0 0 1.25rem;
    color: rgba(246, 232, 207, 0.72);
    text-decoration: none;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .mobile-return-link:hover {
    color: #f1c47a;
  }
</style>
