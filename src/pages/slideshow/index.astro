---
import { withBase } from '@/lib/routes.js';

const slides = Array.from({ length: 11 }, (_, index) => ({
  src: withBase(`/slideshow/Slide_${index + 1}.png`),
  alt: `The Protocol of the Architect orientation slide ${index + 1}`,
  number: index + 1
}));

const enterUrl = withBase('/enter/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="A mobile orientation slideshow for The Protocol of the Architect." />
    <title>The Protocol of the Architect — Orientation</title>
  </head>
  <body>
    <main class="slideshow-shell" aria-label="The Protocol of the Architect orientation slideshow">
      <div class="slide-stage">
        <img id="active-slide" class="slide-image" src={slides[0].src} alt={slides[0].alt} fetchpriority="high" />
      </div>

      <div class="slide-controls" aria-label="Slideshow controls">
        <div class="progress" aria-live="polite">
          <span id="slide-count">1 / {slides.length}</span>
          <div class="progress-track" aria-hidden="true"><span id="progress-bar"></span></div>
        </div>

        <div class="control-row">
          <button id="prev-slide" type="button" class="control-button secondary" disabled>Back</button>
          <button id="next-slide" type="button" class="control-button primary">Next</button>
        </div>
      </div>
    </main>

    <script define:vars={{ slides, enterUrl }}>
      const activeSlide = document.getElementById('active-slide');
      const slideCount = document.getElementById('slide-count');
      const progressBar = document.getElementById('progress-bar');
      const prevButton = document.getElementById('prev-slide');
      const nextButton = document.getElementById('next-slide');
      let current = 0;
      let touchStartX = 0;
      let touchEndX = 0;

      function preloadNext(index) {
        const next = slides[index + 1];
        if (!next) return;
        const img = new Image();
        img.src = next.src;
      }

      function renderSlide() {
        const slide = slides[current];
        activeSlide.src = slide.src;
        activeSlide.alt = slide.alt;
        slideCount.textContent = `${current + 1} / ${slides.length}`;
        progressBar.style.width = `${((current + 1) / slides.length) * 100}%`;
        prevButton.disabled = current === 0;
        nextButton.textContent = current === slides.length - 1 ? 'Enter' : 'Next';
        preloadNext(current);
      }

      function goNext() {
        if (current >= slides.length - 1) {
          sessionStorage.setItem('protocolSlideshowComplete', 'true');
          window.location.href = enterUrl;
          return;
        }

        current += 1;
        renderSlide();
      }

      function goPrev() {
        if (current === 0) return;

        current -= 1;
        renderSlide();
      }

      prevButton.addEventListener('click', goPrev);
      nextButton.addEventListener('click', goNext);

      document.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight' || event.key === ' ') goNext();
        if (event.key === 'ArrowLeft') goPrev();
      });

      activeSlide.addEventListener(
        'touchstart',
        (event) => {
          touchStartX = event.changedTouches[0].screenX;
        },
        { passive: true }
      );

      activeSlide.addEventListener(
        'touchend',
        (event) => {
          touchEndX = event.changedTouches[0].screenX;
          const delta = touchEndX - touchStartX;

          if (Math.abs(delta) < 45) return;
          if (delta < 0) goNext();
          if (delta > 0) goPrev();
        },
        { passive: true }
      );

      renderSlide();
    </script>
  </body>
</html>

<style>
  :root {
    --void: #05070a;
    --ink: #101012;
    --text: #f6e8cf;
    --muted: rgba(246, 232, 207, 0.74);
    --amber: #d9a34f;
    --amber-soft: #f1c47a;
    --blue: #6f93a6;
    --border: rgba(217, 163, 79, 0.45);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    min-height: 100%;
    margin: 0;
    background:
      radial-gradient(circle at 50% 0%, rgba(217, 163, 79, 0.16), transparent 24rem),
      radial-gradient(circle at 80% 30%, rgba(111, 147, 166, 0.12), transparent 24rem),
      var(--void);
    color: var(--text);
    font-family: Georgia, 'Times New Roman', serif;
  }

  body {
    overflow: hidden;
  }

  .slideshow-shell {
    min-height: 100svh;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    padding: max(12px, env(safe-area-inset-top)) 12px max(14px, env(safe-area-inset-bottom));
  }

  .slide-stage {
    min-height: 0;
    display: grid;
    place-items: center;
  }

  .slide-image {
    display: block;
    max-width: min(100%, 520px);
    max-height: calc(100svh - 112px);
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--border);
    box-shadow:
      0 0 42px rgba(0, 0, 0, 0.72),
      0 0 28px rgba(217, 163, 79, 0.08);
    background: #030405;
    touch-action: pan-y;
  }

  .slide-controls {
    width: min(100%, 520px);
    margin: 10px auto 0;
    padding: 10px 0 0;
  }

  .progress {
    display: grid;
    gap: 8px;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
  }

  .progress-track {
    height: 2px;
    background: rgba(246, 232, 207, 0.16);
    overflow: hidden;
  }

  .progress-track span {
    display: block;
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, var(--amber), var(--amber-soft));
    transition: width 180ms ease;
  }

  .control-row {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 10px;
    margin-top: 12px;
  }

  .control-button {
    appearance: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(7, 8, 10, 0.72);
    color: var(--text);
    padding: 12px 16px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.92rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
  }

  .control-button.primary {
    background: linear-gradient(135deg, rgba(217, 163, 79, 0.24), rgba(111, 147, 166, 0.12));
  }

  .control-button:disabled {
    opacity: 0.38;
  }
</style>
